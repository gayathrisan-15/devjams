        <svg class="bg-drone bg-drone-1" viewBox="0 0 100 50"><ellipse cx="50" cy="25" rx="35" ry="12" fill="#71c3d6"/><line x1="38" y1="35" x2="30" y2="46" stroke="#71c3d6" stroke-width="3"/><line x1="62" y1="35" x2="70" y2="46" stroke="#71c3d6" stroke-width="3"/></svg>
        <svg class="bg-drone bg-drone-2" viewBox="0 0 100 50"><ellipse cx="50" cy="25" rx="35" ry="12" fill="#71c3d6"/><line x1="38" y1="35" x2="30" y2="46" stroke="#71c3d6" stroke-width="3"/><line x1="62" y1="35" x2="70" y2="46" stroke="#71c3d6" stroke-width="3"/></svg>
        <svg class="bg-drone bg-drone-3" viewBox="0 0 100 50"><ellipse cx="50" cy="25" rx="35" ry="12" fill="#71c3d6"/><line x1="38" y1="35" x2="30" y2="46" stroke="#71c3d6" stroke-width="3"/><line x1="62" y1="35" x2="70" y2="46" stroke="#71c3d6" stroke-width="3"/></svg>
        <svg class="bg-drone bg-drone-4" viewBox="0 0 100 50"><ellipse cx="50" cy="25" rx="35" ry="12" fill="#71c3d6"/><line x1="38" y1="35" x2="30" y2="46" stroke="#71c3d6" stroke-width="3"/><line x1="62" y1="35" x2="70" y2="46" stroke="#71c3d6" stroke-width="3"/></svg>

