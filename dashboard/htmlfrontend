    <script>
        const canvas = document.getElementById("radarCanvas");
        const ctx = canvas.getContext("2d");
        const container = document.getElementById("radar-box");

        function resizeCanvas() {
            canvas.width = container.clientWidth;
            canvas.height = container.clientHeight;
        }
        window.addEventListener("resize", resizeCanvas);
        resizeCanvas();

        let sweepAngle = 0;
        let selectedDroneId = "DR-03";
        let geofenceLimit = 160.0;
        let renderedNodePoints = {};
        let cycleCount = 1590;

        let droneState = {
            "DR-01": { x: 40, y: -90, speed: 5.7, battery: 18.2, trust_score: 100.0, status: "HEALTHY", trail: [] },
            "DR-03": { x: 110, y: -30, speed: 6.9, battery: 15.2, trust_score: 100.0, status: "HEALTHY", trail: [] },
            "DR-05": { x: 30, y: 110, speed: 30.8, battery: 11.2, trust_score: 100.0, status: "HEALTHY", trail: [] },
            "DR-06": { x: -110, y: 30, speed: 5.4, battery: 8.2, trust_score: 100.0, status: "HEALTHY", trail: [] }
        };

        canvas.addEventListener("click", (evt) => {
            const rect = canvas.getBoundingClientRect();
            const clickX = evt.clientX - rect.left;
            const clickY = evt.clientY - rect.top;

            for (const [id, pt] of Object.entries(renderedNodePoints)) {
                if (Math.hypot(clickX - pt.x, clickY - pt.y) <= 18) {
                    selectDrone(id);
                    break;
                }
            }
        });

        function selectDrone(id) {
            selectedDroneId = id;
            document.getElementById("target-id").innerText = id;
            updateUI();
        }

        function drawRadar() {
            const width = canvas.width;
            const height = canvas.height;
            const centerX = width / 2;
            const centerY = height / 2;
            const maxRadius = Math.min(width, height) * 0.42;

            ctx.clearRect(0, 0, width, height);

            ctx.strokeStyle = "rgba(255, 255, 255, 0.05)";
            ctx.lineWidth = 1;
            const gridSize = 30;
            for (let x = 0; x < width; x += gridSize) {
                ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
            }
            for (let y = 0; y < height; y += gridSize) {
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
            }

            ctx.strokeStyle = "rgba(255, 255, 255, 0.15)";
            for (let r = 1; r <= 3; r++) {
                ctx.beginPath();
                ctx.arc(centerX, centerY, (maxRadius / 3) * r, 0, Math.PI * 2);
                ctx.stroke();
            }

            ctx.strokeStyle = "rgba(239, 68, 68, 0.35)";
            ctx.beginPath(); ctx.moveTo(centerX, 0); ctx.lineTo(centerX, height); ctx.stroke();
            ctx.beginPath(); ctx.moveTo(0, centerY); ctx.lineTo(width, centerY); ctx.stroke();

            const geoRadiusPx = (geofenceLimit / 200) * maxRadius;
            ctx.strokeStyle = "rgba(239, 68, 68, 0.4)";
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.arc(centerX, centerY, geoRadiusPx, 0, Math.PI * 2);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = "#60a5fa";
            ctx.fillRect(centerX - 6, centerY - 6, 12, 12);
            ctx.fillStyle = "#ffffff";
            ctx.font = "bold 9px monospace";
            ctx.fillText("GCS-0", centerX - 14, centerY + 16);

            sweepAngle += 0.015;
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(centerX, centerY);
            ctx.arc(centerX, centerY, maxRadius, sweepAngle - 0.35, sweepAngle);
            ctx.closePath();
            ctx.fillStyle = "rgba(84, 178, 207, 0.12)";
            ctx.fill();
            ctx.restore();

            renderedNodePoints = {};

            for (const [id, drone] of Object.entries(droneState)) {
                const px = centerX + (drone.x / 200) * maxRadius;
                const py = centerY + (drone.y / 200) * maxRadius;
                renderedNodePoints[id] = { x: px, y: py };

                drone.trail.push({ x: px, y: py });
                if (drone.trail.length > 25) drone.trail.shift();

                ctx.strokeStyle = "rgba(255, 255, 255, 0.25)";
                ctx.beginPath();
                for (let i = 0; i < drone.trail.length; i++) {
                    const pt = drone.trail[i];
                    if (i === 0) ctx.moveTo(pt.x, pt.y);
                    else ctx.lineTo(pt.x, pt.y);
                }
                ctx.stroke();

                ctx.strokeStyle = "rgba(255, 255, 255, 0.15)";
                ctx.setLineDash([3, 3]);
                ctx.beginPath();
                ctx.moveTo(centerX, centerY);
                ctx.lineTo(px, py);
                ctx.stroke();
                ctx.setLineDash([]);

                const color = drone.status === "HEALTHY" ? "#10b981" : (drone.status === "SUSPICIOUS" ? "#f59e0b" : "#ef4444");
                
                if (id === selectedDroneId) {
                    ctx.strokeStyle = "#ffffff";
                    ctx.lineWidth = 1.5;
                    ctx.beginPath();
                    ctx.arc(px, py, 11, 0, Math.PI * 2);
                    ctx.stroke();
                }

                ctx.fillStyle = color;
                ctx.beginPath();
                ctx.arc(px, py, 6, 0, Math.PI * 2);
                ctx.fill();

                ctx.fillStyle = "#ffffff";
                ctx.font = "bold 9px monospace";
                ctx.fillText(id, px - 12, py + 16);
            }

            requestAnimationFrame(drawRadar);
        }

        drawRadar();

        function updateUI() {
            let activeCount = 0;
            let isolatedCount = 0;
            let totalTrust = 0;

            const tbody = document.getElementById("drone-table");
            tbody.innerHTML = "";

            for (const [id, drone] of Object.entries(droneState)) {
                if (drone.status !== "ISOLATED") activeCount++;
                else isolatedCount++;
                totalTrust += drone.trust_score;

                const isSelected = id === selectedDroneId ? "selected-row" : "";
                tbody.innerHTML += `
                    <tr class="${isSelected}" onclick="selectDrone('${id}')">
                        <td><b>${id}</b></td>
                        <td><span class="badge badge-${drone.status}">${drone.status}</span></td>
                        <td>${drone.trust_score.toFixed(1)}</td>
                        <td>${drone.speed.toFixed(1)} m/s</td>
                        <td>${drone.battery.toFixed(1)}%</td>
                    </tr>
                `;
            }

            document.getElementById("m-active").innerText = `${activeCount} / ${Object.keys(droneState).length}`;
            document.getElementById("m-isolated").innerText = isolatedCount;
            document.getElementById("m-trust").innerText = `${(totalTrust / Object.keys(droneState).length).toFixed(1)}%`;
        }

        function logConsole(type, droneId, message) {
            const consoleBox = document.getElementById("console-box");
            const div = document.createElement("div");
            div.className = "entry entry-" + type;
            div.innerText = `[Cycle ${cycleCount}] ${type}: [${droneId}] ${message}`;
            consoleBox.prepend(div);
        }

        setInterval(() => {
            cycleCount++;
            let i = 0;
            for (const [id, drone] of Object.entries(droneState)) {
                if (drone.status === "ISOLATED") continue;

                let angle = (cycleCount * 0.03) + (i * (Math.PI / 2));
                let radius = 90.0 + (Math.sin(cycleCount * 0.1 + i) * 15);
                drone.x = radius * Math.cos(angle);
                drone.y = radius * Math.sin(angle);
                drone.battery = Math.max(0, drone.battery - 0.01);

                logConsole("SYSTEM", id, `Packet #${cycleCount} verified.`);
                i++;
            }
            updateUI();
        }, 1200);

        function triggerAttack(type) {
            const target = droneState[selectedDroneId];
            if (!target) return;

            if (type === "GPS_SPOOF") {
                target.x += 100.0;
                target.trust_score -= 35;
            } else if (type === "TAMPER") {
                target.trust_score -= 50;
            } else if (type === "REPLAY") {
                target.trust_score -= 40;
            } else if (type === "GEOFENCE") {
                target.x = 180; target.y = 180;
                target.trust_score -= 30;
            }

            target.trust_score = Math.max(0, target.trust_score);
            target.status = target.trust_score < 40 ? "ISOLATED" : (target.trust_score < 75 ? "SUSPICIOUS" : "HEALTHY");
            logConsole("ATTACK", selectedDroneId, `Threat Injected: ${type}`);

            if (target.status === "ISOLATED") {
                logConsole("ISOLATION", selectedDroneId, `Trust Critical (${target.trust_score.toFixed(1)}). Node isolated.`);
            }
            updateUI();
        }

        function resetSwarm() {
            droneState = {
                "DR-01": { x: 40, y: -90, speed: 5.7, battery: 98.0, trust_score: 100.0, status: "HEALTHY", trail: [] },
                "DR-03": { x: 110, y: -30, speed: 6.9, battery: 95.0, trust_score: 100.0, status: "HEALTHY", trail: [] },
                "DR-05": { x: 30, y: 110, speed: 30.8, battery: 91.0, trust_score: 100.0, status: "HEALTHY", trail: [] },
                "DR-06": { x: -110, y: 30, speed: 5.4, battery: 88.0, trust_score: 100.0, status: "HEALTHY", trail: [] }
            };
            logConsole("SYSTEM", "ALL", "Swarm mesh restored.");
            updateUI();
        }

        logConsole("SYSTEM", "DR-06", "Packet #1596 verified.");
        logConsole("SYSTEM", "DR-05", "Packet #1596 verified.");
        logConsole("SYSTEM", "DR-03", "Packet #1596 verified.");
        logConsole("SYSTEM", "DR-01", "Packet #1596 verified.");
    </script>
</body>
</html>
